<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="leafGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#22c55e;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#16a34a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#15803d;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- White circular background -->
  <circle cx="32" cy="32" r="30" fill="#ffffff"/>
  
  <!-- Simple leaf shape with black outline -->
  <path d="M 32 18 
           Q 26 16, 22 20
           Q 18 24, 20 30
           Q 22 36, 28 40
           Q 32 42, 36 40
           Q 42 36, 44 30
           Q 46 24, 42 20
           Q 38 16, 32 18 Z" 
        fill="url(#leafGrad)"
        stroke="#000000"
        stroke-width="1.5"/>
  
  <!-- Center vein (yellowish-green) -->
  <path d="M 32 18 
           Q 32 24, 32 30
           Q 32 36, 32 42" 
        stroke="#a3e635" 
        stroke-width="2" 
        fill="none" 
        stroke-linecap="round"/>
  
  <!-- Side veins (yellowish-green) -->
  <path d="M 28 22 
           Q 26 24, 24 26" 
        stroke="#a3e635" 
        stroke-width="1.2" 
        fill="none" 
        stroke-linecap="round"/>
  <path d="M 36 22 
           Q 38 24, 40 26" 
        stroke="#a3e635" 
        stroke-width="1.2" 
        fill="none" 
        stroke-linecap="round"/>
  <path d="M 26 28 
           Q 24 30, 22 32" 
        stroke="#a3e635" 
        stroke-width="1.2" 
        fill="none" 
        stroke-linecap="round"/>
  <path d="M 38 28 
           Q 40 30, 42 32" 
        stroke="#a3e635" 
        stroke-width="1.2" 
        fill="none" 
        stroke-linecap="round"/>
  
  <!-- Stem (yellowish-green) -->
  <path d="M 32 42 
           L 32 48" 
        stroke="#a3e635" 
        stroke-width="3" 
        fill="none" 
        stroke-linecap="round"/>
</svg>
